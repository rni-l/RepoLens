{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist-backend",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/backend/**/*.ts", "tests/**/*.ts"]
}
